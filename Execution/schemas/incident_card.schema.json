{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "incident_card.schema.json",
  "title": "IncidentCard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "title",
    "source_type",
    "source_name",
    "source_path",
    "short_summary",
    "canonical_symptoms",
    "affected_components",
    "failure_mode_candidates",
    "observed_phases",
    "incident_phases",
    "turning_points",
    "candidate_explanations",
    "diagnostic_patterns",
    "discriminating_checks",
    "expected_observations",
    "investigation_steps",
    "mitigations_or_workarounds",
    "prevention_or_design_followups",
    "claimed_guarantees",
    "violated_properties",
    "fix_versions",
    "confidence_notes",
    "source_refs"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "vendor_or_project": {
      "type": [
        "string",
        "null"
      ]
    },
    "system_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "version_tested": {
      "type": [
        "string",
        "null"
      ]
    },
    "report_date": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "short_summary": {
      "type": "string",
      "minLength": 1
    },
    "canonical_symptoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affected_components": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_mode_candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed_phases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "incident_phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/incident_phase"
      }
    },
    "turning_points": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidate_explanations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diagnostic_patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "discriminating_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/discriminating_check"
      }
    },
    "expected_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expected_observation"
      }
    },
    "investigation_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "root_cause_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "mitigations_or_workarounds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prevention_or_design_followups": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claimed_guarantees": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "violated_properties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resolution_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "fix_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "incident_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_name",
        "context",
        "symptoms",
        "user_visible_impact",
        "observations",
        "actions_taken",
        "changes_after_actions"
      ],
      "properties": {
        "phase_name": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "symptoms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "user_visible_impact": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actions_taken": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "changes_after_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "discriminating_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "why"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation",
        "effect"
      ],
      "properties": {
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
