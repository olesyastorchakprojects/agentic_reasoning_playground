{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution/schemas/runtime_config.schema.json",
  "title": "Distributed Diagnostics Runtime Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime",
    "retrieval",
    "input_normalization",
    "query_structuring",
    "observation_boundary_resolver",
    "observation_extraction",
    "incident_evidence_retrieval",
    "llm_structured_generation",
    "prompt_context",
    "diagnostic_update_prompt_context",
    "model",
    "observability"
  ],
  "properties": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_version"
      ],
      "properties": {
        "config_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cards",
        "practice",
        "theory"
      ],
      "properties": {
        "cards": { "$ref": "#/$defs/collection_retrieval" },
        "practice": { "$ref": "#/$defs/collection_retrieval" },
        "theory": { "$ref": "#/$defs/collection_retrieval" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport_kind",
        "ollama",
        "together"
      ],
      "properties": {
        "transport_kind": {
          "type": "string",
          "enum": ["ollama", "together"]
        },
        "ollama": { "$ref": "#/$defs/model_transport" },
        "together": { "$ref": "#/$defs/model_transport" }
      }
    },
    "input_normalization": {
      "$ref": "#/$defs/input_normalization"
    },
    "query_structuring": {
      "$ref": "#/$defs/query_structuring"
    },
    "observation_boundary_resolver": {
      "$ref": "#/$defs/observation_boundary_resolver"
    },
    "observation_extraction": {
      "$ref": "#/$defs/observation_extraction"
    },
    "incident_evidence_retrieval": {
      "$ref": "#/$defs/incident_evidence_retrieval"
    },
    "llm_structured_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_output_tokens"
      ],
      "properties": {
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "prompt_context": {
      "$ref": "#/$defs/prompt_context"
    },
    "diagnostic_update_prompt_context": {
      "$ref": "#/$defs/diagnostic_update_prompt_context"
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracing_enabled",
        "metrics_enabled",
        "trace_batch_scheduled_delay_ms",
        "metrics_export_interval_ms"
      ],
      "properties": {
        "tracing_enabled": {
          "type": "boolean"
        },
        "metrics_enabled": {
          "type": "boolean"
        },
        "trace_batch_scheduled_delay_ms": {
          "type": "integer",
          "minimum": 1
        },
        "metrics_export_interval_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "backoff"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "backoff": {
          "type": "string",
          "enum": ["exponential"]
        }
      }
    },
    "collection_retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top_k",
        "score_threshold",
        "max_alternatives",
        "embedding_retry",
        "qdrant_retry"
      ],
      "properties": {
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "score_threshold": {
          "type": "number"
        },
        "max_alternatives": {
          "type": "integer",
          "minimum": 0
        },
        "embedding_retry": { "$ref": "#/$defs/retry" },
        "qdrant_retry": { "$ref": "#/$defs/retry" }
      }
    },
    "model_transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_name",
        "timeout_sec",
        "retry"
      ],
      "properties": {
        "model_name": {
          "type": "string",
          "minLength": 1
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "retry": { "$ref": "#/$defs/retry" }
      }
    },
    "input_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_tokens",
        "tokenizer_source"
      ],
      "properties": {
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "tokenizer_source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "query_structuring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlled_vocabulary_path",
        "prompt_asset_path",
        "max_output_tokens"
      ],
      "properties": {
        "controlled_vocabulary_path": {
          "type": "string",
          "minLength": 1
        },
        "prompt_asset_path": {
          "type": "string",
          "minLength": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "observation_boundary_resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "prompt_asset_path",
        "max_output_tokens"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt_asset_path": {
          "type": "string",
          "minLength": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "observation_extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "prompt_asset_path",
        "max_output_tokens"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt_asset_path": {
          "type": "string",
          "minLength": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "incident_evidence_tag_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_tags",
        "alternative_tags"
      ],
      "properties": {
        "primary_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "alternative_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "incident_evidence_retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval",
        "profiles"
      ],
      "properties": {
        "retrieval": { "$ref": "#/$defs/collection_retrieval" },
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial",
            "continuation"
          ],
          "properties": {
            "initial": { "$ref": "#/$defs/incident_evidence_tag_profile" },
            "continuation": { "$ref": "#/$defs/incident_evidence_tag_profile" }
          }
        }
      }
    },
    "prompt_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_asset_path",
        "chunk_packing"
      ],
      "properties": {
        "prompt_asset_path": {
          "type": "string",
          "minLength": 1
        },
        "chunk_packing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_for_match",
            "first_check_hint",
            "supporting_explanation",
            "alternative_context",
            "mechanism_explanation"
          ],
          "properties": {
            "evidence_for_match": { "$ref": "#/$defs/incident_chunk_role_required" },
            "first_check_hint": { "$ref": "#/$defs/incident_chunk_role_required" },
            "supporting_explanation": { "$ref": "#/$defs/incident_chunk_role_optional" },
            "alternative_context": { "$ref": "#/$defs/alternative_chunk_role" },
            "mechanism_explanation": { "$ref": "#/$defs/theory_chunk_role" }
          }
        }
      }
    },
    "diagnostic_update_prompt_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_asset_path",
        "chunk_packing"
      ],
      "properties": {
        "prompt_asset_path": {
          "type": "string",
          "minLength": 1
        },
        "chunk_packing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_for_match",
            "next_check_hint",
            "supporting_explanation",
            "alternative_context",
            "mechanism_explanation"
          ],
          "properties": {
            "evidence_for_match": { "$ref": "#/$defs/incident_chunk_role_required" },
            "next_check_hint": { "$ref": "#/$defs/incident_chunk_role_required" },
            "supporting_explanation": { "$ref": "#/$defs/incident_chunk_role_optional" },
            "alternative_context": { "$ref": "#/$defs/alternative_chunk_role" },
            "mechanism_explanation": { "$ref": "#/$defs/theory_chunk_role" }
          }
        }
      }
    },
    "incident_chunk_role_required": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "limit",
        "fallback_to_any_chunk",
        "tag_priority"
      ],
      "properties": {
        "source": {
          "type": "string",
          "const": "primary_incident"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "fallback_to_any_chunk": {
          "type": "boolean"
        },
        "tag_priority": { "$ref": "#/$defs/incident_chunk_tag_priority" }
      }
    },
    "incident_chunk_role_optional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "limit",
        "fallback_to_any_chunk",
        "tag_priority"
      ],
      "properties": {
        "source": {
          "type": "string",
          "const": "primary_incident"
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "fallback_to_any_chunk": {
          "type": "boolean"
        },
        "tag_priority": { "$ref": "#/$defs/incident_chunk_tag_priority" }
      }
    },
    "alternative_chunk_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "limit",
        "fallback_to_any_chunk",
        "tag_priority"
      ],
      "if": {
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["limit"]
      },
      "then": {
        "required": ["per_case_limit"],
        "properties": {
          "per_case_limit": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "properties": {
        "source": {
          "type": "string",
          "const": "alternative_incident"
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "per_case_limit": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_to_any_chunk": {
          "type": "boolean"
        },
        "tag_priority": { "$ref": "#/$defs/incident_chunk_tag_priority" }
      }
    },
    "theory_chunk_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "limit",
        "fallback_to_any_chunk",
        "tag_priority"
      ],
      "properties": {
        "source": {
          "type": "string",
          "const": "theory"
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_to_any_chunk": {
          "type": "boolean"
        },
        "tag_priority": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "incident_chunk_tag_priority": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "chunk_role:symptom",
          "chunk_role:impact",
          "chunk_role:timeline",
          "chunk_role:symptom_change",
          "chunk_role:investigation",
          "chunk_role:diagnostic_step",
          "chunk_role:hypothesis_update",
          "chunk_role:recovery",
          "chunk_role:failure_mode",
          "chunk_role:root_cause",
          "chunk_role:contributing_factor",
          "chunk_role:uncertainty",
          "chunk_role:lesson"
        ]
      }
    }
  }
}
