@startuml
title Orchestration Run State Model

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty methods

package "orchestrator" {
  class Orchestrator {
    - policy: TransitionPolicy
    - executor: StepExecutor
    - run_repository: RunRepository
    + run(user_input: UserRequest): RunOutcome
    + resume(run_id: RunId): RunOutcome
    + resume_with_input(run_id: RunId, user_input: UserRequest): RunOutcome
  }

  interface TransitionPolicy {
    + next_transition(state: RunStateView): PolicyTransition
  }

  class LinearPipelineTransitionPolicy
  class DiagnosticLoopTransitionPolicy

  interface StepExecutor {
    + execute(step: StepKind, state: RunStateView): StepResultEnvelope
    + execute_with_context(step: StepKind, state: RunStateView, context: Context): StepResultEnvelope
  }

  class RunRepository {
    + create_run(run: RunState)
    + load_run(run_id: RunId)
    + append_iteration(run: RunState, iteration_sequence_no: u64, iteration: RunIteration)
    + append_step_record(run: RunState, iteration_id: RunIterationId, step_sequence_no: u64, step_record: StepRecord)
    + finish_step_record(run: RunState, record_id: StepRecordId, finished_record: FinishedStepRecord)
    + update_run_header(run: RunState)
    + update_iteration_status(run: RunState, iteration_id: RunIterationId, status: RunIterationStatus)
    + list_runs(): Vec<RunListItem>
  }

  enum PolicyTransition {
    ExecuteStep(step: StepKind)
    WaitForUser(follow_up_questions: Vec<String>)
    FinishWithResult(result: ResponseValidationAndNormalizationOutput)
    FinishWithError(error: StepError)
  }

  enum RunOutcome {
    Finished(run_id: RunId, result: ResponseValidationAndNormalizationOutput)
    WaitingForUser(run_id: RunId, follow_up_questions: Vec<String>)
    Failed(run_id: RunId, error: StepError)
  }

  class OrchestratorError
  class PolicyError
  class RunRepositoryError
  class StateApplyError
}

package "orchestrator.run_state.model" {
  class RunId {
    + value: Uuid
  }

  class StepRecordId {
    + value: Uuid
  }

  class RunIterationId {
    + value: Uuid
  }

  enum RunStatus {
    Active
    WaitingForUser
    Error
    Archived
  }

  enum RunIterationStatus {
    Active
    FinishedWithSuccess
    FinishedWithError
    FinishedWithWaitInput
  }

  class RunState {
    + run_id: RunId
    + status: RunStatus
    + created_at: DateTime<Utc>
    + updated_at: DateTime<Utc>
    + revision: u64
    + iterations: Vec<RunIteration>
  }

  enum StepKind {
    UserInputReceived
    InputNormalization
    QueryStructuring
    InformationAdequacyInitial
    InformationAdequacySupportedObservation
    InformationAdequacyUnsupportedObservation
    CandidateCardRetrieval
    CardBranchReranking
    CardHydration
    IncidentEvidenceRetrieval
    TheoryEvidenceRetrieval
    PromptContextAssembly
    DiagnosticUpdatePromptContextAssembly
    LlmStructuredGeneration
    ResponseValidationAndNormalization
    ObservationBoundaryResolver
    ObservationExtraction
  }

  enum StepResultEnvelope {
    UserInputReceived(UserRequest)
    InputNormalization(NormalizedUserRequest)
    QueryStructuring(QueryStructuringOutput)
    InformationAdequacy(AdequacyAssessment)
    CandidateCardRetrieval(CandidateCardRetrievalOutput)
    CardBranchReranking(CardBranchRerankingOutput)
    CardHydration(CardHydrationOutput)
    IncidentEvidenceRetrieval(IncidentEvidenceRetrievalOutput)
    TheoryEvidenceRetrieval(TheoryEvidenceRetrievalOutput)
    PromptContextAssembly(PromptContextAssemblyOutput)
    DiagnosticUpdatePromptContextAssembly(PromptContextAssemblyOutput)
    LlmStructuredGeneration(LlmStructuredGenerationOutput)
    ResponseValidationAndNormalization(ResponseValidationAndNormalizationOutput)
    ObservationBoundaryResolver(ObservationBoundaryResolverOutput)
    ObservationExtraction(ObservationExtractionOutput)
  }

  enum StepError {
    MissingRequiredInput(message: String)
    InvalidState(message: String)
    InputNormalization(InputNormalizationError)
    QueryStructuring(QueryStructuringError)
    InformationAdequacy(InformationAdequacyAnalyzerError)
    CandidateCardRetrieval(CandidateCardRetrievalError)
    CardBranchReranking(CardBranchRerankingError)
    CardHydration(CardHydrationError)
    IncidentEvidenceRetrieval(IncidentEvidenceRetrievalError)
    TheoryEvidenceRetrieval(TheoryEvidenceRetrievalError)
    PromptContextAssembly(PromptContextAssemblyError)
    DiagnosticUpdatePromptContextAssembly(DiagnosticUpdatePromptContextAssemblyError)
    LlmStructuredGeneration(LlmStructuredGenerationError)
    ResponseValidationAndNormalization(ResponseValidationAndNormalizationError)
    ObservationBoundaryResolver(ObservationBoundaryResolverError)
    ObservationExtraction(ObservationExtractionError)
    ExternalDependency(message: String)
    Unexpected(message: String)
  }

  enum StepRecord {
    Pending(PendingStepRecord)
    Finished(FinishedStepRecord)
  }

  class PendingStepRecord {
    + record_id: StepRecordId
    + step: StepKind
    + started_at: DateTime<Utc>
  }

  class FinishedStepRecord {
    + record_id: StepRecordId
    + step: StepKind
    + started_at: DateTime<Utc>
    + finished_at: DateTime<Utc>
    + result: Result<StepResultEnvelope, StepError>
  }

  class RunIteration {
    + iteration_id: RunIterationId
    + config_snapshot: Option<RunConfigSnapshot>
    + status: RunIterationStatus
    + step_records: Vec<StepRecord>
  }
}

package "orchestrator.run_state.view" {
  class RunStateView {
    - state: RunState
    + new(state: &RunState): RunStateView
    + run_id(): RunId
    + status(): RunStatus
    + iteration_count(): usize
    + iteration(iteration_id: RunIterationId): RunIteration
    + iterations(): IterationView
    + normal_iterations(): IterationView
    + short_iterations(): IterationView
    + last_iteration(): IterationView
  }

  class IterationView {
    - iteration: RunIteration
    + iteration_id(): RunIterationId
    + status(): RunIterationStatus
    + step_count(): usize
    + steps(): StepView
    + finished_steps(): FinishedStepView
    + pending_step(): PendingStepView
    + finished_step(kind: StepKind): FinishedStepView
    + is_normal_iteration(): bool
    + is_short_iteration(): bool
  }

  enum StepView {
    Pending(PendingStepView)
    Finished(FinishedStepView)
  }

  class PendingStepView {
    - record: PendingStepRecord
    + record_id(): StepRecordId
    + kind(): StepKind
    + started_at(): DateTime<Utc>
    + to_owned(): PendingStepRecord
  }

  class FinishedStepView {
    - record: FinishedStepRecord
    + record_id(): StepRecordId
    + kind(): StepKind
    + started_at(): DateTime<Utc>
    + finished_at(): DateTime<Utc>
    + result(): Result<StepResultEnvelope, StepError>
    + to_owned(): FinishedStepRecord
  }
}

package "orchestrator.run_state.apply" {
  class RunStateWriter {
    - state: RunState
    + new(state: &mut RunState): RunStateWriter
    + begin_iteration(user_input: UserRequest): CurrentIterationWriter
    + current_iteration(): CurrentIterationWriter
    + finish_current_iteration_success()
    + finish_current_iteration_error()
    + wait_for_user()
    + archive_run()
  }

  class CurrentIterationWriter {
    - state: RunState
    - iteration_index: usize
    + iteration_id(): RunIterationId
    + begin_step(step: StepKind): PendingStepWriter
    + pending_step(): PendingStepWriter
  }

  class PendingStepWriter {
    - state: RunState
    - iteration_index: usize
    - step_index: usize
    + record_id(): StepRecordId
    + kind(): StepKind
    + record_success(result: StepResultEnvelope)
    + record_failure(error: StepError)
  }
}

package "shared orchestration types" {
  class UserRequest
  class NormalizedUserRequest
  class AdequacyAssessment
  class QueryStructuringOutput
  class CandidateCardRetrievalOutput
  class CardBranchRerankingOutput
  class CardHydrationOutput
  class IncidentEvidenceRetrievalOutput
  class TheoryEvidenceRetrievalOutput
  class PromptContextAssemblyOutput
  class LlmStructuredGenerationOutput
  class ResponseValidationAndNormalizationOutput
  class ObservationBoundaryResolverOutput
  class ObservationExtractionOutput
  class RunConfigSnapshot
  class Context
  class RunListItem
}

Orchestrator --> TransitionPolicy
Orchestrator --> StepExecutor
Orchestrator --> RunRepository
Orchestrator --> RunStateWriter
Orchestrator ..> RunOutcome
Orchestrator ..> OrchestratorError

LinearPipelineTransitionPolicy ..|> TransitionPolicy
DiagnosticLoopTransitionPolicy ..|> TransitionPolicy
TransitionPolicy ..> RunStateView
TransitionPolicy ..> PolicyTransition
TransitionPolicy ..> PolicyError

StepExecutor ..> RunStateView
StepExecutor ..> StepKind
StepExecutor ..> StepResultEnvelope
StepExecutor ..> StepError
StepExecutor ..> Context

RunRepository ..> RunState
RunRepository ..> RunIteration
RunRepository ..> StepRecord
RunRepository ..> FinishedStepRecord
RunRepository ..> RunListItem
RunRepository ..> RunRepositoryError

RunState *-- RunId
RunState *-- "0..*" RunIteration
RunState --> RunStatus
RunIteration *-- RunIterationId
RunIteration *-- "0..*" StepRecord
RunIteration --> RunIterationStatus
RunIteration --> RunConfigSnapshot

StepRecord --> PendingStepRecord
StepRecord --> FinishedStepRecord
PendingStepRecord *-- StepRecordId
PendingStepRecord --> StepKind
FinishedStepRecord *-- StepRecordId
FinishedStepRecord --> StepKind
FinishedStepRecord --> StepResultEnvelope
FinishedStepRecord --> StepError

RunStateView --> RunState
RunStateView ..> IterationView
IterationView --> RunIteration
IterationView ..> StepView
IterationView ..> PendingStepView
IterationView ..> FinishedStepView
StepView --> PendingStepView
StepView --> FinishedStepView
PendingStepView --> PendingStepRecord
FinishedStepView --> FinishedStepRecord

RunStateWriter --> RunState
RunStateWriter ..> CurrentIterationWriter
RunStateWriter ..> StateApplyError
CurrentIterationWriter --> RunState
CurrentIterationWriter ..> PendingStepWriter
PendingStepWriter --> RunState
PendingStepWriter ..> StepRecord

StepResultEnvelope ..> UserRequest
StepResultEnvelope ..> NormalizedUserRequest
StepResultEnvelope ..> AdequacyAssessment
StepResultEnvelope ..> QueryStructuringOutput
StepResultEnvelope ..> CandidateCardRetrievalOutput
StepResultEnvelope ..> CardBranchRerankingOutput
StepResultEnvelope ..> CardHydrationOutput
StepResultEnvelope ..> IncidentEvidenceRetrievalOutput
StepResultEnvelope ..> TheoryEvidenceRetrievalOutput
StepResultEnvelope ..> PromptContextAssemblyOutput
StepResultEnvelope ..> LlmStructuredGenerationOutput
StepResultEnvelope ..> ResponseValidationAndNormalizationOutput
StepResultEnvelope ..> ObservationBoundaryResolverOutput
StepResultEnvelope ..> ObservationExtractionOutput

PolicyTransition ..> ResponseValidationAndNormalizationOutput
PolicyTransition ..> StepError
RunOutcome ..> ResponseValidationAndNormalizationOutput
RunOutcome ..> StepError

note right of RunState
  Canonical persisted run container.
  User input, intermediate results, and
  final outputs live inside iteration-scoped
  StepRecord history rather than on RunState.
end note

note right of RunIteration
  One run may contain multiple iterations:
  the initial request plus later continuations.
  Iteration status distinguishes normal,
  short wait-for-user, and error outcomes.
end note

note bottom of RunStateView
  Borrowed navigation over runs,
  iterations, and step records.
  Also exposes normal vs short
  iteration classification helpers.
end note

note bottom of RunStateWriter
  The only mutation boundary for run_state.
  Opens iterations, starts steps,
  records success/failure, and
  closes iterations explicitly.
end note

@enduml
