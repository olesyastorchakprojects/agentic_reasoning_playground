@startuml
title Orchestration Run State Model

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty methods

package "orchestrator" {
  class Orchestrator {
    - policy: TransitionPolicy
    - executor: StepExecutor
    - run_repository: RunRepository
    + run(request: UserRequest): RunState
    + resume(run_id: RunId): RunState
  }

  interface TransitionPolicy {
    + decide(view: RunStateView): TransitionDecision
  }

  interface StepExecutor {
    + execute(view: RunStateView, step: StepKind): StepResultEnvelope
  }

  interface RunRepository {
    + insert(state: RunState)
    + save(state: RunState)
    + load(run_id: RunId): RunState
    + list_active(): Vec<RunState>
  }

  enum TransitionDecision {
    Execute(step: StepKind)
    WaitForUserInput
    SurfaceExecutionError
    PauseActiveRun
  }

  enum StepKind {
    UserInputReceived
    InputNormalization
    QueryStructuring
    CandidateCardRetrieval
    CardHydration
    IncidentEvidenceRetrieval
    TheoryEvidenceRetrieval
    PromptContextAssembly
    LlmStructuredGeneration
    ResponseValidationAndNormalization
  }

  enum StepResultEnvelope {
    UserInputReceived(UserRequest)
    InputNormalization(NormalizedUserRequest)
    QueryStructuring(QueryStructuringOutput)
    CandidateCardRetrieval(CandidateCardRetrievalOutput)
    CardHydration(CardHydrationOutput)
    IncidentEvidenceRetrieval(IncidentEvidenceRetrievalOutput)
    TheoryEvidenceRetrieval(TheoryEvidenceRetrievalOutput)
    PromptContextAssembly(PromptContextAssemblyOutput)
    LlmStructuredGeneration(LlmStructuredGenerationOutput)
    ResponseValidationAndNormalization(ResponseValidationAndNormalizationOutput)
  }

  class OrchestratorError
  class StepExecutionError
  class RunRepositoryError
  class StateApplyError
}

package "orchestrator.run_state.model" {
  class RunId {
    + value: Uuid
  }

  enum RunStatus {
    Active
    WaitingForUser
    Error
    Archived
  }

  class RunState {
    + run_id: RunId
    + status: RunStatus
    + created_at: DateTime<Utc>
    + updated_at: DateTime<Utc>
    + revision: u64
    + iterations: Vec<RunIteration>
  }

  class RunIterationId {
    + value: Uuid
  }

  class StepRecordId {
    + value: Uuid
  }

  enum StepError {
    MissingRequiredInput(message: String)
    InvalidState(message: String)
    InputNormalization(InputNormalizationError)
    QueryStructuring(QueryStructuringError)
    CandidateCardRetrieval(CandidateCardRetrievalError)
    CardHydration(CardHydrationError)
    IncidentEvidenceRetrieval(IncidentEvidenceRetrievalError)
    TheoryEvidenceRetrieval(TheoryEvidenceRetrievalError)
    PromptContextAssembly(PromptContextAssemblyError)
    LlmStructuredGeneration(LlmStructuredGenerationError)
    ResponseValidationAndNormalization(ResponseValidationAndNormalizationError)
    ExternalDependency(message: String)
    Unexpected(message: String)
  }

  enum StepRecord {
    Pending(PendingStepRecord)
    Finished(FinishedStepRecord)
  }

  class PendingStepRecord {
    + record_id: StepRecordId
    + step: StepKind
    + started_at: DateTime<Utc>
  }

  class FinishedStepRecord {
    + record_id: StepRecordId
    + step: StepKind
    + started_at: DateTime<Utc>
    + finished_at: DateTime<Utc>
    + result: Result<StepResultEnvelope, StepError>
  }

  class RunIteration {
    + iteration_id: RunIterationId
    + step_records: Vec<StepRecord>
  }
}

package "orchestrator.run_state.view" {
  class RunStateView {
    - state: RunState
    + new(state: &RunState): RunStateView
    + run_id(): RunId
    + status(): RunStatus
    + iterations(): impl DoubleEndedIterator<Item = IterationView>
    + last_iteration(): Option<IterationView>
  }

  class IterationView {
    - iteration: RunIteration
    + iteration_id(): RunIterationId
    + steps(): impl DoubleEndedIterator<Item = StepView>
    + finished_steps(): impl DoubleEndedIterator<Item = FinishedStepView>
    + pending_step(): Option<PendingStepView>
    + finished_step(kind: StepKind): Option<FinishedStepView>
  }

  enum StepView {
    Pending(PendingStepView)
    Finished(FinishedStepView)
  }

  class PendingStepView {
    - record: PendingStepRecord
    + record_id(): StepRecordId
    + kind(): StepKind
    + started_at(): DateTime<Utc>
  }

  class FinishedStepView {
    - record: FinishedStepRecord
    + record_id(): StepRecordId
    + kind(): StepKind
    + started_at(): DateTime<Utc>
    + finished_at(): DateTime<Utc>
    + result(): &Result<StepResultEnvelope, StepError>
  }
}

package "orchestrator.run_state.apply" {
  class RunStateWriter {
    - state: RunState
    + new(state: &mut RunState): RunStateWriter
    + begin_iteration(user_input: UserRequest): Result<CurrentIterationWriter, StateApplyError>
    + current_iteration(): Result<CurrentIterationWriter, StateApplyError>
    + wait_for_user(): Result<(), StateApplyError>
    + archive_run(): Result<(), StateApplyError>
  }

  class CurrentIterationWriter {
    - state: RunState
    - iteration_index: usize
    + iteration_id(): RunIterationId
    + begin_step(step: StepKind): Result<PendingStepWriter, StateApplyError>
    + pending_step(): Option<PendingStepWriter>
  }

  class PendingStepWriter {
    - state: RunState
    - iteration_index: usize
    - step_index: usize
    + record_id(): StepRecordId
    + kind(): StepKind
    + record_success(result: StepResultEnvelope): Result<(), StateApplyError>
    + record_failure(error: StepError): Result<(), StateApplyError>
  }
}

package "shared request-pipeline types" {
  class UserRequest {
    + query: String
  }

  class NormalizedUserRequest {
    + query: String
    + input_token_count: usize
  }

  class QueryStructuringOutput
  class QueryStructuringError
  class CandidateCardRetrievalOutput
  class CandidateCardRetrievalError
  class CardHydrationOutput
  class CardHydrationError
  class IncidentEvidenceRetrievalOutput
  class IncidentEvidenceRetrievalError
  class TheoryEvidenceRetrievalOutput
  class TheoryEvidenceRetrievalError
  class PromptContextAssemblyOutput
  class PromptContextAssemblyError
  class LlmStructuredGenerationOutput
  class LlmStructuredGenerationError
  class ResponseValidationAndNormalizationOutput {
    + response: DiagnosticResponse
  }
  class ResponseValidationAndNormalizationError
  class InputNormalizationError

  class DiagnosticResponse {
    + problem_understanding: String
    + similar_practical_context: String
    + active_hypotheses: Vec<String>
    + first_check: String
    + result_interpretation: DiagnosticResultInterpretation
    + competing_interpretation: Option<String>
  }

  class DiagnosticResultInterpretation {
    + supports_primary_if: String
    + supports_competing_if: String
    + inconclusive_if: Option<String>
  }

  enum PromptEvidenceRole {
    EvidenceForMatch
    FirstCheckHint
    SupportingExplanation
    AlternativeContext
    MechanismExplanation
  }
}

Orchestrator --> TransitionPolicy
Orchestrator --> StepExecutor
Orchestrator --> RunRepository
Orchestrator --> RunStateWriter

TransitionPolicy ..> RunStateView
TransitionPolicy ..> TransitionDecision
StepExecutor ..> RunStateView
StepExecutor ..> StepKind
StepExecutor ..> StepResultEnvelope
RunRepository ..> RunState

RunState *-- RunId
RunState *-- "0..*" RunIteration
RunState --> RunStatus
RunIteration *-- RunIterationId
RunIteration *-- "0..*" StepRecord

StepRecord --> PendingStepRecord
StepRecord --> FinishedStepRecord
PendingStepRecord *-- StepRecordId
PendingStepRecord --> StepKind
FinishedStepRecord *-- StepRecordId
FinishedStepRecord --> StepKind
FinishedStepRecord --> StepResultEnvelope
FinishedStepRecord --> StepError

RunStateView --> RunState
RunStateView ..> IterationView
IterationView --> RunIteration
IterationView ..> StepView
IterationView ..> PendingStepView
IterationView ..> FinishedStepView
StepView --> PendingStepView
StepView --> FinishedStepView
PendingStepView --> PendingStepRecord
FinishedStepView --> FinishedStepRecord

RunStateWriter --> RunState
RunStateWriter ..> CurrentIterationWriter
CurrentIterationWriter --> RunState
CurrentIterationWriter ..> PendingStepWriter
PendingStepWriter --> RunState
PendingStepWriter ..> StepRecord

StepResultEnvelope ..> UserRequest
StepResultEnvelope ..> NormalizedUserRequest
StepResultEnvelope ..> QueryStructuringOutput
StepResultEnvelope ..> CandidateCardRetrievalOutput
StepResultEnvelope ..> CardHydrationOutput
StepResultEnvelope ..> IncidentEvidenceRetrievalOutput
StepResultEnvelope ..> TheoryEvidenceRetrievalOutput
StepResultEnvelope ..> PromptContextAssemblyOutput
StepResultEnvelope ..> LlmStructuredGenerationOutput
StepResultEnvelope ..> ResponseValidationAndNormalizationOutput

ResponseValidationAndNormalizationOutput --> DiagnosticResponse
DiagnosticResponse --> DiagnosticResultInterpretation

note right of RunState
  Canonical persisted container.
  No top-level user request or output slots.
  Step outputs live in iteration-scoped StepRecord history.
end note

note bottom of RunStateView
  Borrowed navigation over
  iterations and step records.
end note

note bottom of RunStateWriter
  Only mutation boundary for run_state.
  Appends and updates StepRecord history.
end note

@enduml
